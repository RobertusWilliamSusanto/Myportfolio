---
import type { ProjectCatalogItem } from '../data/projectCatalog';

interface Props {
  item: ProjectCatalogItem;
  lang: 'id' | 'en';
}

const { item, lang } = Astro.props;
const summaryLabel = lang === 'id'
  ? `Intip Spesifikasi (${item.techStack.length} Stack)`
  : `Peek Specs (${item.techStack.length} Stack)`;
---
<details class="project-peek-details border-t border-outline-variant/20 mt-3 pt-2">
  <summary class="btn-interactive inline-flex items-center justify-between w-full font-mono text-xs text-secondary cursor-pointer min-h-[44px] px-1 list-none select-none">
    <span>{summaryLabel}</span>
    <span class="peek-chevron inline-block font-mono text-sm leading-none" aria-hidden="true">+</span>
  </summary>
  <div class="peek-body pt-2 pb-1 flex flex-col gap-1.5 text-xs text-on-surface-variant">
    {item.metrics && (
      <div class="font-mono text-[11px] text-secondary font-medium">&gt; {item.metrics}</div>
    )}
    <ul class="list-none p-0 m-0 flex flex-col gap-1">
      {item.highlights.map((h) => (
        <li class="flex items-start gap-1.5">
          <span class="text-secondary shrink-0" aria-hidden="true">•</span>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  </div>
</details>
