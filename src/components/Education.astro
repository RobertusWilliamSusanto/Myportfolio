---
---
<!-- EDUCATION & CREDENTIALS -->
<section id="education" class="scroll-reveal relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-10 py-16 border-t border-outline-variant/20" aria-label="Education & Credentials">
  <div class="flex flex-col gap-10">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-outline font-semibold">ACADEMIC FOUNDATION</span>
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary mt-1">Education &amp; Credentials</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Degree Card -->
      <div class="lg:col-span-2 p-6 md:p-8 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col justify-between gap-6">
        <div class="flex flex-col gap-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="px-2.5 py-1 rounded bg-secondary-container text-secondary-fixed font-mono text-[11px] font-semibold">UNDERGRADUATE DEGREE</span>
            <span class="font-mono text-xs text-outline">AGUSTUS 2024 — SEKARANG</span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-primary">Universitas Diponegoro</h3>
          <p class="text-sm md:text-base text-secondary font-medium">
            Fakultas Teknik — Jurusan Teknik Komputer
          </p>
          <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
            Menempuh pendidikan sarjana Teknik Komputer dengan pendalaman pada arsitektur sistem cerdas, kecerdasan buatan terapan (computer vision), struktur data, algoritma, serta pengembangan perangkat lunak terintegrasi.
          </p>
        </div>
        <div class="p-4 rounded-lg bg-surface-container border border-outline-variant/20 flex items-center justify-between">
          <span class="font-mono text-xs text-outline">LOKASI KAMPUS</span>
          <span class="font-mono text-xs text-on-surface">Semarang, Jawa Tengah, Indonesia</span>
        </div>
      </div>

      <!-- Certifications Card -->
      <div class="p-6 md:p-8 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col justify-between gap-6">
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2">
            <span class="text-secondary" aria-hidden="true">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
              </svg>
            </span>
            <h3 class="text-base font-semibold text-primary">Sertifikasi &amp; Kegiatan</h3>
          </div>
          <ul class="flex flex-col gap-3 text-xs md:text-sm text-on-surface-variant list-none p-0 m-0">
            <li class="flex items-start gap-2">
              <span class="text-secondary shrink-0 mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              </span>
              <span>Cisco Jaringan Komputer (Packet Tracer)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-secondary shrink-0 mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              </span>
              <span>KP Dinas Kebudayaan dan Pariwisata Kota Semarang</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-secondary shrink-0 mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              </span>
              <span>Panitia Prakarsa FT (Fakultas Teknik)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-secondary shrink-0 mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              </span>
              <span>LKKMPD (Latihan Keterampilan Manajemen Mahasiswa)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-secondary shrink-0 mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              </span>
              <span>Volunteer Himaskom Menanam</span>
            </li>
          </ul>
        </div>
        <div class="p-3 rounded bg-surface-container flex items-center justify-between">
          <span class="font-mono text-[11px] text-outline">STATUS</span>
          <span class="font-mono text-[11px] text-secondary font-semibold">ACADEMIC CREDENTIALS</span>
        </div>
      </div>

    </div>
  </div>
</section>
