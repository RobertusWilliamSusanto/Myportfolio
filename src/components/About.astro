<section id="about" class="scroll-reveal relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-10 py-16 border-t border-outline-variant/20" aria-label="About Information">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-3">
      <span class="font-mono text-xs uppercase tracking-widest text-outline font-semibold">ABOUT</span>
    </div>

    <div class="lg:col-span-5 flex flex-col gap-5 text-on-surface-variant text-sm md:text-base leading-relaxed">
      <p class="text-on-surface font-medium">
        Computer Engineering Student at Diponegoro University with a focus on AI Development (Computer Vision) and Software Engineering. Experienced in building high-accuracy detection models and managing end-to-end technical projects.
      </p>
      <p>
        Committed to delivering user-centered digital solutions through robust teamwork, scalable architecture, and cross-platform technical expertise. Experienced with deep convolutional neural networks, YOLO object detection pipelines, and high-performance backend APIs.
      </p>
      <div class="p-4 rounded-lg bg-surface-container-low border border-outline-variant/30 flex items-center gap-3">
        <span class="text-secondary shrink-0" aria-hidden="true">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
          </svg>
        </span>
        <span class="font-mono text-xs text-on-surface">Semarang, Indonesia • Universitas Diponegoro (Teknik Komputer)</span>
      </div>
    </div>

    <!-- Terminal Card -->
    <div class="lg:col-span-4 rounded-xl bg-surface-container-low border border-outline-variant/40 p-5 shadow-lg font-mono text-xs" role="region" aria-label="Developer Profile Environment">
      <div class="flex items-center gap-2 mb-4 pb-2 border-b border-outline-variant/20">
        <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block" aria-hidden="true"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block" aria-hidden="true"></span>
        <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block" aria-hidden="true"></span>
        <span class="text-outline text-[11px] ml-2 tracking-wide font-sans">robertus.info</span>
      </div>
      <div class="flex flex-col gap-3 leading-relaxed">
        <div>
          <span class="text-secondary font-medium">&gt; status</span>
          <p class="text-on-surface pl-3 font-sans text-xs">Undergraduate Computer Engineering Student</p>
        </div>
        <div>
          <span class="text-secondary font-medium">&gt; institution</span>
          <p class="text-on-surface pl-3 font-sans text-xs">Diponegoro University</p>
        </div>
        <div>
          <span class="text-secondary font-medium">&gt; focus_areas</span>
          <p class="text-on-surface pl-3 font-sans text-xs">Computer Vision, CNN, YOLO, Software Eng</p>
        </div>
        <div>
          <span class="text-secondary font-medium">&gt; contact</span>
          <p class="text-on-surface-variant pl-3 font-mono text-xs truncate">robertuswilliamsusanto@gmail.com</p>
        </div>
      </div>
    </div>
  </div>
</section>
