---
interface Props {
  title: string;
  nodes: string[];
}

const { title, nodes } = Astro.props;
---
<div class="arch-strip mt-3 p-2.5 rounded-lg bg-surface-container-lowest border border-outline-variant/25 flex flex-col gap-1.5">
  <div class="font-mono text-[10px] uppercase tracking-wider text-outline font-semibold">{title}</div>
  <div class="flex flex-wrap items-center gap-1.5">
    {nodes.map((node, idx) => (
      <>
        <code class="arch-node px-2 py-0.5 rounded bg-surface-container text-[11px] font-mono text-on-surface border border-outline-variant/30">{node}</code>
        {idx < nodes.length - 1 && (
          <span class="text-secondary text-xs font-mono" aria-hidden="true">→</span>
        )}
      </>
    ))}
  </div>
</div>
