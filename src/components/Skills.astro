---
---
<!-- SKILLS MATRIX (STRICTLY FROM CV) -->
<section id="skills" class="scroll-reveal relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-10 py-16 border-t border-outline-variant/20" aria-label="Technical Capabilities">
  <div class="flex flex-col gap-10">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-outline font-semibold">SKILLS MATRIX</span>
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary mt-1">Technical Capabilities</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-group">

      <!-- Category 1: Programming -->
      <div class="scroll-reveal p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-secondary" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
            </svg>
          </span>
          <h3 class="text-base font-semibold text-primary">Programming</h3>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant">Core programming languages for algorithms and backend development.</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Python</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">C++</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">TypeScript</span>
        </div>
      </div>

      <!-- Category 2: AI / ML -->
      <div class="scroll-reveal p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-secondary" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M21 16.5C21 16.88 20.79 17.21 20.47 17.38L12.57 21.82C12.41 21.94 12.21 22 12 22C11.79 22 11.59 21.94 11.43 21.82L3.53 17.38C3.21 17.21 3 16.88 3 16.5V7.5C3 7.12 3.21 6.79 3.53 6.62L11.43 2.18C11.59 2.06 11.79 2 12 2C12.21 2 12.41 2.06 12.57 2.18L20.47 6.62C20.79 6.79 21 7.12 21 7.5V16.5Z"/>
            </svg>
          </span>
          <h3 class="text-base font-semibold text-primary">AI &amp; Machine Learning</h3>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant">Object detection frameworks, neural nets, and visual data processing.</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">CNN</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">YOLO</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Image Processing</span>
        </div>
      </div>

      <!-- Category 3: Tools & Design -->
      <div class="scroll-reveal p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-secondary" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9zm-5.5 10c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
            </svg>
          </span>
          <h3 class="text-base font-semibold text-primary">Tools &amp; Design</h3>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant">Data analysis, computation, prototyping, and UI design.</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">NumPy</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Matplotlib</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Figma</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Canva</span>
        </div>
      </div>

      <!-- Category 4: Hardware & Embedded -->
      <div class="scroll-reveal p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-secondary" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z"/>
            </svg>
          </span>
          <h3 class="text-base font-semibold text-primary">Hardware &amp; Embedded</h3>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant">Embedded logic, digital circuits, and simulation tools.</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Microcontroller</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Digital Logic</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Circuit Simulation</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Wokwi</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Tinkercad</span>
        </div>
      </div>

      <!-- Category 5: Backend & Cloud (From SIBARISTA Intern Experience) -->
      <div class="scroll-reveal p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-secondary" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM4 3h16c.55 0 1 .45 1 1v6c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1V4c0-.55.45-1 1-1z"/>
            </svg>
          </span>
          <h3 class="text-base font-semibold text-primary">Backend &amp; Cloud</h3>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant">Production backend frameworks, ORMs, and databases from intern experience.</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">NestJS</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Prisma ORM</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">PostgreSQL</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Cloudinary</span>
        </div>
      </div>

      <!-- Category 6: Languages -->
      <div class="scroll-reveal p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <span class="text-secondary" aria-hidden="true">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
            </svg>
          </span>
          <h3 class="text-base font-semibold text-primary">Languages</h3>
        </div>
        <p class="text-xs md:text-sm text-on-surface-variant">Spoken and written communication proficiencies.</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">Indonesian (Native)</span>
          <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-xs">English (Intermediate)</span>
        </div>
      </div>

    </div>
  </div>
</section>
