---
---
<!-- CONTACT & ENGAGEMENT SECTION -->
<section id="contact" class="scroll-reveal relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-10 py-20 border-t border-outline-variant/20" aria-label="Contact Section">
  <div class="rounded-xl bg-surface-container-low border border-outline-variant/30 p-8 md:p-12 shadow-xl flex flex-col lg:flex-row items-start lg:items-center justify-between gap-10">
    <div class="flex flex-col gap-3 max-w-xl">
      <span class="font-mono text-xs uppercase tracking-widest text-outline font-semibold">GET IN TOUCH</span>
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary">
        Let’s build something meaningful.
      </h2>
      <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
        Tertarik berkolaborasi dalam rekayasa sistem AI, Computer Vision, atau arsitektur backend software engineering? Silakan hubungi saya melalui email resmi di bawah ini.
      </p>
    </div>

    <div class="w-full lg:w-auto flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
      <a class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded bg-primary text-on-primary text-sm font-semibold shadow hover:bg-primary-container hover-lift min-h-[44px]" href="https://mail.google.com/mail/?view=cm&fs=1&to=robertuswilliamsusanto@gmail.com" target="_blank" rel="noopener noreferrer" onclick="openDirectEmail(event)">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
        <span>Kirim Email Langsung</span>
      </a>

      <button type="button" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded bg-surface-container-high border border-outline-variant/30 text-on-surface text-sm font-medium hover:bg-surface-bright hover-lift min-h-[44px]" onclick="copyEmailAddress(this)">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
        </svg>
        <span class="copy-label font-mono text-xs">Copy robertuswilliamsusanto@gmail.com</span>
      </button>

      <!-- Social Links -->
      <div class="flex items-center justify-center gap-3 pt-2">
        <a aria-label="GitHub Profile" class="p-2.5 rounded bg-surface-container text-on-surface-variant hover:text-primary hover:bg-surface-bright transition-colors flex items-center justify-center min-h-[44px] min-w-[44px]" href="https://github.com/RobertusWilliamSusanto" target="_blank" rel="noopener noreferrer">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"/>
          </svg>
        </a>

        <a aria-label="LinkedIn Profile" class="p-2.5 rounded bg-surface-container text-on-surface-variant hover:text-primary hover:bg-surface-bright transition-colors flex items-center justify-center min-h-[44px] min-w-[44px]" href="https://www.linkedin.com/in/robertuswilliamsusanto" target="_blank" rel="noopener noreferrer">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.53 1.53 0 0 0 1.53-1.53c0-.85-.68-1.54-1.53-1.54-.85 0-1.54.69-1.54 1.54 0 .85.69 1.53 1.54 1.53m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
          </svg>
        </a>

        <a aria-label="Direct Email" class="p-2.5 rounded bg-surface-container text-on-surface-variant hover:text-primary hover:bg-surface-bright transition-colors flex items-center justify-center min-h-[44px] min-w-[44px]" href="https://mail.google.com/mail/?view=cm&fs=1&to=robertuswilliamsusanto@gmail.com" target="_blank" rel="noopener noreferrer" onclick="openDirectEmail(event)">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
