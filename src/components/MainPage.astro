---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import MobileDrawer from './MobileDrawer.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Projects from './Projects.astro';
import Experience from './Experience.astro';
import Skills from './Skills.astro';
import Education from './Education.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import BottomNav from './BottomNav.astro';
import ChatbotMount from './ChatbotMount.astro';
import ProjectModal from '../islands/ProjectModal';
import type { Lang } from '../data/profile';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;

const pageTitle = lang === 'id'
  ? 'Robertus William Susanto — Portofolio'
  : 'Robertus William Susanto — Portfolio';

const pageDesc = lang === 'id'
  ? 'Portofolio Robertus William Susanto - Mahasiswa Teknik Komputer Universitas Diponegoro. Berfokus pada Artificial Intelligence, Computer Vision, dan Rekayasa Perangkat Lunak.'
  : 'Portfolio of Robertus William Susanto - Computer Engineering Student at Diponegoro University. Focusing on AI Development (Computer Vision, YOLO >90%) and Software Engineering.';
---
<BaseLayout lang={lang} title={pageTitle} description={pageDesc}>
  <!-- Header / Navigation -->
  <Navbar lang={lang} />

  <!-- Mobile Drawer Overlay Menu -->
  <MobileDrawer lang={lang} />

  <!-- Main Content Landmark -->
  <main id="main-content" class="w-full pt-16 bg-surface min-h-screen">
    <!-- Background Dot Pattern (CSS radial gradient) -->
    <div class="relative w-full overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-[0.04] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px] z-0" aria-hidden="true"></div>
      <!-- Static Hero Depth Glow (E5) -->
      <div class="hero-glow" aria-hidden="true"></div>

      <!-- Hero Section -->
      <Hero lang={lang} />

      <!-- About Section -->
      <About lang={lang} />

      <!-- Selected Projects -->
      <Projects lang={lang} />

      <!-- Experience & Leadership Timeline -->
      <Experience lang={lang} />

      <!-- Skills Matrix -->
      <Skills lang={lang} />

      <!-- Education & Credentials -->
      <Education lang={lang} />

      <!-- Contact Section -->
      <Contact lang={lang} />
    </div>
  </main>

  <!-- Global Footer -->
  <Footer lang={lang} />

  <!-- Mobile Sticky Bottom Navigation -->
  <BottomNav lang={lang} />

  <!-- Project Detail Modal Island (Preact Client-Side Portal) -->
  <ProjectModal client:idle lang={lang} />

  <!-- AI Chatbot Island -->
  <ChatbotMount />
</BaseLayout>
