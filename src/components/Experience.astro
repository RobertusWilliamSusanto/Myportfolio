---
import { experience, getLocalized, type Lang } from '../data/profile';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;

const sectionTag = lang === 'id' ? 'PENGALAMAN & KEPEMIMPINAN' : 'EXPERIENCE & LEADERSHIP';
const sectionTitle = lang === 'id' ? 'Rekam Jejak & Pengalaman Praktis' : 'Track Record & Practical Experience';

const exp1 = experience[0];
const exp2 = experience[1];
const exp3 = experience[2];
const exp4 = experience[3];
---
<!-- EXPERIENCE & LEADERSHIP TIMELINE -->
<section id="experience" class="scroll-reveal relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-10 py-16 border-t border-outline-variant/20" aria-label={sectionTitle}>
  <div class="flex flex-col gap-10">
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-outline font-semibold">{sectionTag}</span>
      <h2 class="text-2xl sm:text-3xl font-semibold text-primary mt-1">{sectionTitle}</h2>
    </div>

    <!-- Timeline Container with Stagger Group (E4 Ladder A) -->
    <div class="relative flex flex-col gap-8 stagger-group">
      <!-- Timeline Draw Line via CSS view timeline (E5) -->
      <div class="timeline-draw-line absolute left-3.5 md:left-4 top-3 bottom-3 w-0.5 bg-surface-container-highest" aria-hidden="true"></div>
      
      <!-- Item 1: Dinas Kebudayaan dan Pariwisata Kota Semarang -->
      <div class="scroll-reveal relative flex items-start gap-5 sm:gap-6 group">
        <div class="relative z-10 w-7 md:w-8 h-7 md:h-8 rounded-full bg-surface-container-high border border-outline-variant/50 flex items-center justify-center shrink-0 group-hover:border-secondary transition-colors" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
        </div>
        <div class="w-full flex flex-col lg:flex-row lg:items-start justify-between gap-4 p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift">
          <div class="flex flex-col gap-2 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm md:text-base font-semibold text-primary">{getLocalized(exp1.title, lang)}</h3>
              <span class="font-mono text-xs text-outline">@ {getLocalized(exp1.institution, lang)}</span>
            </div>
            <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
              {getLocalized(exp1.description, lang)}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2">
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">NestJS</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">TypeScript</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Prisma ORM</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">PostgreSQL (Neon)</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">JWT &amp; RBAC</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Cloudinary</span>
            </div>
          </div>
          <div class="shrink-0 flex flex-col lg:items-end gap-1">
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-secondary font-mono text-[11px] font-semibold">{getLocalized(exp1.period, lang).toUpperCase()}</span>
            <span class="font-mono text-xs text-outline">{getLocalized(exp1.type, lang)}</span>
          </div>
        </div>
      </div>

      <!-- Item 2: Dewan Perwakilan Angkatan -->
      <div class="scroll-reveal relative flex items-start gap-5 sm:gap-6 group">
        <div class="relative z-10 w-7 md:w-8 h-7 md:h-8 rounded-full bg-surface-container-high border border-outline-variant/50 flex items-center justify-center shrink-0 group-hover:border-secondary transition-colors" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-outline"></span>
        </div>
        <div class="w-full flex flex-col lg:flex-row lg:items-start justify-between gap-4 p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift">
          <div class="flex flex-col gap-2 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm md:text-base font-semibold text-primary">{getLocalized(exp2.title, lang)}</h3>
              <span class="font-mono text-xs text-outline">@ {getLocalized(exp2.institution, lang)}</span>
            </div>
            <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
              {getLocalized(exp2.description, lang)}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2">
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">SOP &amp; Anggaran</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Governance</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Leadership</span>
            </div>
          </div>
          <div class="shrink-0 flex flex-col lg:items-end gap-1">
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">{getLocalized(exp2.period, lang).toUpperCase()}</span>
            <span class="font-mono text-xs text-outline">{getLocalized(exp2.type, lang)}</span>
          </div>
        </div>
      </div>

      <!-- Item 3: Pengurus PMK FT 2026 -->
      <div class="scroll-reveal relative flex items-start gap-5 sm:gap-6 group">
        <div class="relative z-10 w-7 md:w-8 h-7 md:h-8 rounded-full bg-surface-container-high border border-outline-variant/50 flex items-center justify-center shrink-0 group-hover:border-secondary transition-colors" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-outline"></span>
        </div>
        <div class="w-full flex flex-col lg:flex-row lg:items-start justify-between gap-4 p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift">
          <div class="flex flex-col gap-2 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm md:text-base font-semibold text-primary">{getLocalized(exp3.title, lang)}</h3>
              <span class="font-mono text-xs text-outline">@ {getLocalized(exp3.institution, lang)}</span>
            </div>
            <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
              {getLocalized(exp3.description, lang)}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2">
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Desain Grafis</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Identitas Digital</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Figma</span>
            </div>
          </div>
          <div class="shrink-0 flex flex-col lg:items-end gap-1">
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">{getLocalized(exp3.period, lang).toUpperCase()}</span>
            <span class="font-mono text-xs text-outline">{getLocalized(exp3.type, lang)}</span>
          </div>
        </div>
      </div>

      <!-- Item 4: Panitia Prakarsa FT 2025 -->
      <div class="scroll-reveal relative flex items-start gap-5 sm:gap-6 group">
        <div class="relative z-10 w-7 md:w-8 h-7 md:h-8 rounded-full bg-surface-container-high border border-outline-variant/50 flex items-center justify-center shrink-0 group-hover:border-secondary transition-colors" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-outline"></span>
        </div>
        <div class="w-full flex flex-col lg:flex-row lg:items-start justify-between gap-4 p-6 rounded-xl bg-surface-container-low border border-outline-variant/30 hover-lift">
          <div class="flex flex-col gap-2 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm md:text-base font-semibold text-primary">{getLocalized(exp4.title, lang)}</h3>
              <span class="font-mono text-xs text-outline">@ {getLocalized(exp4.institution, lang)}</span>
            </div>
            <p class="text-xs md:text-sm text-on-surface-variant leading-relaxed">
              {getLocalized(exp4.description, lang)}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-2">
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Infrastruktur Panggung</span>
              <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">Logistik Acara</span>
            </div>
          </div>
          <div class="shrink-0 flex flex-col lg:items-end gap-1">
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-on-surface font-mono text-[11px]">{getLocalized(exp4.period, lang).toUpperCase()}</span>
            <span class="font-mono text-xs text-outline">{getLocalized(exp4.type, lang)}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
