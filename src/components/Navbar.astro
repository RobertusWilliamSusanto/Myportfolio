---
import ThemeToggle from './ThemeToggle.astro';
---
<header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl border-b border-outline-variant/30">
  <div class="h-16 max-w-[1280px] mx-auto px-4 md:px-10 flex items-center justify-between gap-6">
    
    <!-- Logo -->
    <div class="flex items-center gap-4">
      <a class="flex items-center gap-2 text-primary hover:opacity-80 transition-opacity font-bold tracking-tight text-base uppercase" href="#about">
        <span>PORTFOLIO ROBERTUS</span>
      </a>
    </div>

    <!-- Desktop Nav Links -->
    <nav id="desktop-nav" class="hidden lg:flex items-center gap-1" aria-label="Main Navigation">
      <a class="px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors rounded" href="#about">About</a>
      <a class="px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors rounded" href="#projects">Projects</a>
      <a class="px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors rounded" href="#experience">Experience</a>
      <a class="px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors rounded" href="#skills">Skills</a>
      <a class="px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors rounded" href="#education">Education</a>
      <a class="px-3 py-1.5 text-xs text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors rounded" href="#contact">Contact</a>
    </nav>

    <!-- Action Buttons -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Connect CTA -->
      <a class="hidden sm:inline-flex items-center justify-center px-4 py-2 rounded bg-primary text-on-primary text-xs font-semibold hover:bg-primary-container transition-colors min-h-[44px]" href="https://mail.google.com/mail/?view=cm&fs=1&to=robertuswilliamsusanto@gmail.com" target="_blank" rel="noopener noreferrer" onclick="openDirectEmail(event)">
        Connect
      </a>

      <!-- Mobile Drawer Hamburger Button -->
      <button type="button" id="mobile-drawer-open" aria-label="Open navigation menu" class="lg:hidden w-11 h-11 min-h-[44px] min-w-[44px] flex items-center justify-center rounded bg-surface-container border border-outline-variant/30 text-on-surface-variant hover:text-on-surface">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
      </button>
    </div>

  </div>
</header>
