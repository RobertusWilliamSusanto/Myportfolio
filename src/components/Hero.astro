---
import { profile, getLocalized, type Lang } from '../data/profile';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;

const availabilityStatus = getLocalized(profile.identity.availability.status, lang);
const roleTag = lang === 'id'
  ? 'Mahasiswa Teknik Komputer // Universitas Diponegoro'
  : 'Computer Engineering Student // Diponegoro University';

const summaryText = lang === 'id'
  ? profile.summary.id.value
  : profile.summary.en.value;

const viewProjectsText = lang === 'id' ? 'Lihat Proyek' : 'View Projects';
const downloadCvText = lang === 'id' ? 'Unduh CV' : 'Download CV';
const copiedFeedback = lang === 'id' ? 'TERSALIN KE CLIPBOARD!' : 'COPIED TO CLIPBOARD!';
const copyEmailAria = lang === 'id' ? 'Salin alamat email' : 'Copy email address';
---
<!-- HERO SECTION -->
<section class="relative z-10 w-full max-w-[1280px] mx-auto px-4 md:px-10 pt-16 pb-16 md:py-24 flex flex-col items-center text-center justify-center" aria-label="Hero Introduction">
  <!-- Status Pill with Compositor-Only Radar Pulse (E2 Ladder A) -->
  <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-surface-container-high border border-outline-variant/40 mb-8 shadow-sm">
    <span class="relative flex h-2.5 w-2.5 items-center justify-center" aria-hidden="true">
      <span class="status-dot-pulse"></span>
    </span>
    <span class="font-mono text-[11px] uppercase tracking-wider text-on-surface font-medium">{availabilityStatus}</span>
  </div>

  <!-- Real Portrait Avatar with Picture element and responsive WebP/AVIF -->
  <div class="relative w-36 h-36 md:w-44 md:h-44 rounded-full overflow-hidden border-2 border-outline-variant/50 shadow-2xl mb-6 mx-auto bg-surface-container-high">
    <picture>
      <source srcset="/images/profile-352.avif" type="image/avif">
      <source srcset="/images/profile-352.webp" type="image/webp">
      <img 
        src="/profile.png" 
        alt="Portrait of Robertus William Susanto" 
        width="176" 
        height="176" 
        loading="eager" 
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-top img-zoom"
      >
    </picture>
  </div>

  <!-- Role tag with CSS steps typing on desktop, smooth fade on mobile (E3 Ladder A) -->
  <div class="hero-mono-container font-mono text-xs uppercase tracking-widest text-outline mb-3 font-medium">
    <span class="hero-mono-typing">{roleTag}</span>
  </div>

  <!-- H1 Hero Name with Safe Per-Word Mask Reveal (Ladder A) -->
  <h1 class="text-3xl sm:text-5xl md:text-6xl tracking-tight text-primary font-bold m-0 max-w-4xl leading-tight min-h-[75px]">
    <span class="hero-word"><span class="hero-word-inner">Robertus</span></span>{' '}
    <span class="hero-word"><span class="hero-word-inner">William</span></span>{' '}
    <span class="hero-word"><span class="hero-word-inner">Susanto</span></span>
  </h1>

  <!-- Subtitle from summary -->
  <p class="text-sm sm:text-base md:text-lg text-on-surface-variant max-w-2xl mt-4 leading-relaxed font-normal">
    {lang === 'id' ? (
      <>
        Berfokus pada <strong class="text-on-surface font-semibold">Pengembangan AI (Computer Vision)</strong> dan <strong class="text-on-surface font-semibold">Rekayasa Perangkat Lunak</strong>. Berpengalaman membangun model deteksi objek berakurasi tinggi (&gt;90% evaluasi) serta mengelola proyek teknis secara terintegrasi.
      </>
    ) : (
      <>
        Focusing on <strong class="text-on-surface font-semibold">AI Development (Computer Vision)</strong> and <strong class="text-on-surface font-semibold">Software Engineering</strong>. Experienced in building high-accuracy detection models (&gt;90% evaluation) and managing end-to-end technical projects.
      </>
    )}
  </p>

  <!-- Hero CTAs -->
  <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mt-8 w-full max-w-md sm:max-w-none">
    <a class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded bg-primary text-on-primary text-sm font-semibold shadow hover:bg-primary-container hover-lift min-h-[44px] min-w-[140px]" href="#projects">
      <span>{viewProjectsText}</span>
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14m-6-6l6 6-6 6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
      </svg>
    </a>
    
    <a class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded bg-surface-container-high border border-outline-variant/40 text-on-surface text-sm font-medium hover:bg-surface-bright hover-lift min-h-[44px]" href="/CV.pdf" download="CV_Robertus_William_Susanto.pdf">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 16l4-4h-3V4h-2v8H8l4 4zm-8 4v2h16v-2H4z"/>
      </svg>
      <span>{downloadCvText}</span>
    </a>

    <button type="button" class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded bg-surface-container border border-outline-variant/30 text-on-surface-variant hover:text-primary hover:bg-surface-container-high hover-lift min-h-[44px]" onclick="copyEmailAddress(this)" aria-label={copyEmailAria} data-copied-text={copiedFeedback}>
      <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      </svg>
      <span class="copy-label font-mono text-xs">robertuswilliamsusanto@gmail.com</span>
    </button>
  </div>

</section>
