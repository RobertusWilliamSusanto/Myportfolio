---
import type { Lang } from '../data/profile';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;

const overviewLabel = lang === 'id' ? 'Ikhtisar' : 'Overview';
const projectsLabel = lang === 'id' ? 'Proyek Pilihan' : 'Selected Projects';
const expLabel = lang === 'id' ? 'Pengalaman & Kepemimpinan' : 'Experience & Leadership';
const skillsLabel = lang === 'id' ? 'Keahlian & Perkakas' : 'Skills & Capabilities';
const eduLabel = lang === 'id' ? 'Pendidikan & Kredensial' : 'Education & Credentials';
const contactLabel = lang === 'id' ? 'Kontak' : 'Contact';
const closeAria = lang === 'id' ? 'Tutup menu navigasi' : 'Close navigation menu';
const openToWorkText = lang === 'id' ? 'TERSEDIA UNTUK PELUANG' : 'OPEN TO WORK';
const targetHref = lang === 'id' ? '/en/' : '/';
const switchAria = lang === 'id' ? 'Switch language to English' : 'Ganti bahasa ke Bahasa Indonesia';
---
<div id="mobile-drawer" class="hidden fixed inset-0 z-50 bg-surface/95 backdrop-blur-2xl p-6 flex flex-col justify-between pt-safe pb-safe" aria-hidden="true">
  <div class="flex justify-between items-center h-14 border-b border-outline-variant/20 pb-2">
    <span class="font-mono text-xs text-primary font-semibold uppercase tracking-wider">Robertus William Susanto</span>
    <div class="flex items-center gap-3">
      <!-- Language Switcher in Mobile Drawer -->
      <div class="flex items-center gap-1 px-2.5 py-1 rounded bg-surface-container border border-outline-variant/30 font-mono text-xs">
        {lang === 'id' ? (
          <>
            <span class="font-bold text-primary" aria-current="page">ID</span>
            <span class="text-outline/40">|</span>
            <a 
              href={targetHref} 
              class="text-outline hover:text-primary transition-colors" 
              lang="en" 
              hreflang="en" 
              aria-label={switchAria}
              onclick="if(window.location.hash) this.href = '/en/' + window.location.hash"
            >
              EN
            </a>
          </>
        ) : (
          <>
            <a 
              href={targetHref} 
              class="text-outline hover:text-primary transition-colors" 
              lang="id" 
              hreflang="id" 
              aria-label={switchAria}
              onclick="if(window.location.hash) this.href = '/' + window.location.hash"
            >
              ID
            </a>
            <span class="text-outline/40">|</span>
            <span class="font-bold text-primary" aria-current="page">EN</span>
          </>
        )}
      </div>
      <button type="button" id="mobile-drawer-close" aria-label={closeAria} class="w-11 h-11 min-h-[44px] min-w-[44px] flex items-center justify-center text-on-surface">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
  </div>
  <nav class="flex flex-col gap-6 py-8" aria-label="Mobile Drawer Navigation">
    <a class="text-on-surface hover:text-primary text-2xl font-semibold transition-colors" href="#about">{overviewLabel}</a>
    <a class="text-on-surface hover:text-primary text-2xl font-semibold transition-colors" href="#projects">{projectsLabel}</a>
    <a class="text-on-surface hover:text-primary text-2xl font-semibold transition-colors" href="#experience">{expLabel}</a>
    <a class="text-on-surface hover:text-primary text-2xl font-semibold transition-colors" href="#skills">{skillsLabel}</a>
    <a class="text-on-surface hover:text-primary text-2xl font-semibold transition-colors" href="#education">{eduLabel}</a>
    <a class="text-on-surface hover:text-primary text-2xl font-semibold transition-colors" href="#contact">{contactLabel}</a>
  </nav>
  <div class="flex flex-col gap-3 pt-4 border-t border-outline-variant/30">
    <div class="flex items-center justify-between text-on-surface-variant font-mono text-xs">
      <span>SEMARANG, ID</span>
      <span class="text-secondary font-medium">{openToWorkText}</span>
    </div>
    <a class="text-on-surface-variant hover:text-primary font-mono text-xs py-2 break-all" href="https://mail.google.com/mail/?view=cm&fs=1&to=robertuswilliamsusanto@gmail.com" target="_blank" rel="noopener noreferrer" onclick="openDirectEmail(event)">robertuswilliamsusanto@gmail.com</a>
  </div>
</div>
